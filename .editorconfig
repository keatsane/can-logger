# editorconfig.org
root = true

# defaults for everything
[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# c / c++
[*.{c,cpp,h,hpp}]
indent_size = 4
max_line_length = 100

# cmake / data / config
[{*.cmake,*.json,*.yaml,*.yml,CMakeLists.txt}]
indent_size = 2

# device tree
[*.{dts,dtsi}]
indent_style = tab

# makefiles need real tabs
[Makefile]
indent_style = tab

# markdown - keep trailing spaces for hard breaks
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# python - pep 8
[*.py]
indent_size = 4
max_line_length = 100
