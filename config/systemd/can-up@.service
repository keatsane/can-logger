# normal mode: the controller acks and error-flags on the bus. disable for can_obd before listen-only
[Unit]
Description=Bring %i up at 500 kbit/s
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
# listen-only stays set across down and up until it's turned off, so always say which mode
ExecStart=/usr/bin/ip link set %i up type can bitrate 500000 listen-only off
ExecStop=/usr/bin/ip link set %i down

[Install]
WantedBy=multi-user.target
