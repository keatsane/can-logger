# started by hand on purpose: no [Install], so it can't be enabled and poll the car at boot
[Unit]
Description=can-logger, polls obd-ii and writes records
After=can-up@can_obd.service

[Service]
ExecStart=/home/keating/can-logger/build/logger
WorkingDirectory=/home/keating/logs
User=keating
Restart=on-failure
RestartSec=5
WatchdogSec=10
